# Phase 8A Dealer Node load test — disabled by default
LOAD_TEST_ENABLED=false
LOAD_TEST_TOKEN=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
# Hard server-side safety ceiling for dedicated load-test endpoints
LOAD_TEST_MAX_RPS=2500

# Phase 8D alert engine (optional; defaults shown)
ALERT_TRIGGER_SAMPLES=4
ALERT_RECOVERY_SAMPLES=3
ALERT_CPU_PERCENT=80
ALERT_RAM_PERCENT=85
ALERT_API_P95_MS=500
ALERT_API_5XX_RATE=0.01
ALERT_EVENT_LOOP_P95_MS=100
ALERT_PG_WAITING=1
ALERT_CAPACITY_PERCENT=80
